---
import Base from '../../layouts/Base.astro';
---
<Base title="Message sent" description="Thanks for contacting David McMahon." noindex>
  <div class="wrap page">
    <h1>Thanks</h1>
    <p class="sub">Your message is in. I will reply soon.</p>
    <p style="margin-top:24px"><a class="link" href="/">Back to the homepage</a></p>
  </div>
</Base>
<script is:inline>
  (function () {
    var sent = false;
    try { sent = sessionStorage.getItem('contact_form_submit') === '1'; } catch (e) {}
    if (sent) return;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: 'contact_form_submit', form_name: 'contact' });
    try { sessionStorage.setItem('contact_form_submit', '1'); } catch (e) {}
  })();
</script>
