---
import Base from '../layouts/Base.astro';
import { GALLERY } from '../data/gallery';
const sections = Object.entries(GALLERY);
---
<Base title="Gallery" description="Photos and video from David McMahon's life: Butler football, rugby, the Campbell Trophy Leadership Summit, and family in Sarasota and Indianapolis." breadcrumbs={[{ name: 'Gallery', path: '/gallery/' }]}>
  <div class="wrap page">
    <h1>Gallery</h1>
    <p class="sub">Football, Butler, family, and the people and places along the way.</p>

    <section class="reel">
      <h2>Nolan Surfing</h2>
      <figure>
        <video controls playsinline preload="metadata" poster="/video/nolan-surfing-highlights-poster.jpg" aria-label="Highlights of Nolan surfing">
          <source src="/video/nolan-surfing-highlights.mp4" type="video/mp4" />
        </video>
      </figure>
    </section>
    <section class="reel">
      <h2>Nolan Skimboarding</h2>
      <figure>
        <video controls playsinline preload="metadata" poster="/video/nolan-skimboarding-highlights-poster.jpg" aria-label="Highlights of Nolan skimboarding">
          <source src="/video/nolan-skimboarding-highlights.mp4" type="video/mp4" />
        </video>
      </figure>
    </section>

    {sections.map(([name, photos]) => (
      <section>
        <h2>{name}</h2>
        <div class="gallery">
          {photos.map((p) => (
            <figure>
              <img src={p.src} width={p.w} height={p.h} alt={p.alt} loading="lazy" decoding="async" />
              <figcaption>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
<style>
  h2{margin-top:44px}
  .gallery{columns:2 320px;column-gap:28px;margin-top:20px}
  .gallery figure{break-inside:avoid;margin:0 0 28px}
  .gallery img{width:100%;height:auto;display:block;border:1px solid var(--gray-light)}
  .gallery figcaption{font-size:14px;color:var(--blue-soft);margin-top:8px}
  .reel figure{margin:20px 0 0;max-width:360px}
  .reel video{width:100%;height:auto;aspect-ratio:9/16;display:block;background:var(--blue-deep);border:1px solid var(--gray-light);object-fit:cover}
</style>
