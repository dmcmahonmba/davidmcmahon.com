---
import { NAV, SITE } from '../data/site';
const { current = '' } = Astro.props;
const active = (href: string) => (href === '/' ? current === '/' : current.startsWith(href));
---
<header class="site-header">
  <div class="wrap bar">
    <a class="logo" href="/">David McMahon</a>
    <nav aria-label="Main">
      <ul>
        {NAV.map((n) => (
          <li><a href={n.href} class={active(n.href) ? 'on' : ''} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
